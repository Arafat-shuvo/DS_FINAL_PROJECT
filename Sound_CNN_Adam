  plt.close(fig)\n\ndef plot_curves(hist: pd.DataFrame, title, path, show=False):\n    fig, axes = plt.subplots(2, 2, figsize=(11, 7))\n    spec = [(\"train_loss\", \"Training Loss vs Epoch\", \"Loss\"), (\"val_loss\", \"Validation Loss vs Epoch\", \"Loss\"),\n            (\"train_acc\", \"Training Accuracy vs Epoch\", \"Accuracy\"), (\"val_acc\", \"Validation Accuracy vs Epoch\", \"Accuracy\")]\n    best_ep = hist.loc[hist[\"val_macro_f1\"].idxmax(), \"epoch\"]\n    for ax, (col, ttl, yl) in zip(axes.ravel(), spec):\n        ax.plot(hist[\"epoch\"], hist[col], label=col.replace(\"_\", \" \"))\n        ax.axvline(best_ep, color=\"red\", ls=\"--\", alpha=0.6, label=f\"best epoch ({int(best_ep)})\")\n        ax.set_title(ttl); ax.set_xlabel(\"Epoch\"); ax.set_ylabel(yl); ax.legend(); ax.grid(alpha=0.3)\n    fig.suptitle(title); fig.tight_layout(); fig.savefig(path, dpi=150)\n    if show: plt.show()\n    plt.close(fig)\n\n# Save a confusion matrix and a curve figure for EVERY run (cheap), display only the best run per optimizer.\n# \"Best\" = highest VALIDATION Macro-F1 (never test).\nbest_run_ids = results_df.loc[results_df.groupby(\"optimizer\")[\"best_val_macro_f1\"].idxmax(), \"run_id\"].tolist()\n(FIG_DIR / \"confusion_matrices\").mkdir(exist_ok=True); (FIG_DIR / \"training_curves\").mkdir(exist_ok=True)\nfor r in tqdm(results_df.to_dict(\"records\"), desc=\"Saving figures\"):\n    rdir = RUNS_DIR / r[\"run_id\"]\n    show = r[\"run_id\"] in best_run_ids\n    ttl = f\"{r['optimizer']} lr={r['learning_rate']:g} seed={r['seed']}\"\n    plot_confusion(np.load(rdir / \"confusion_matrix.npy\"),\n                   f\"Confusion matrix (test) — {ttl}\\nacc={r['test_accuracy']:.3f}, macro-F1={r['test_macro_f1']:.3f}\",\n                   FIG_DIR / \"confusion_matrices\" / f\"cm_{r['run_id']}.png\", show=show)\n    plot_curves(pd.read_csv(rdir / \"history.csv\"), f\"Training curves — {ttl}\",\n                FIG_DIR / \"training_curves\" / f\"curves_{r['run_id']}.png\", 