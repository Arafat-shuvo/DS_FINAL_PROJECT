39a48-fc67-49bb-86f3-ed9058fdb9a7","cell_type":"code","source":"# ============================================================\n# 1. IMPORT LIBRARIES AND ENVIRONMENT SETUP\n# ============================================================\nimport os, sys, gc, json, time, copy, random, hashlib, platform\nos.environ.setdefault(\"CUBLAS_WORKSPACE_CONFIG\", \":4096:8\")   # needed for deterministic CUDA matmuls\n\nfrom pathlib import Path\nfrom collections import Counter\n\nimport numpy as np\nimport pandas as pd\nimport matplotlib.pyplot as plt\nimport librosa\nimport torch\nimport torch.nn as nn\nfrom torch.utils.data import DataLoader, TensorDataset\nfrom tqdm.auto import tqdm\nfrom sklearn.metrics import roc_auc_score, confusion_matrix\n\n# ---- Smoke-test switch: set env RESP_SMOKE_TEST=1 to run 1 run x 2 epochs into a separate folder ----\nSMOKE_TEST = os.environ.get(\"RESP_SMOKE_TEST\", \"0\") == \"1\"\n\n# ---- Experiment configuration (exact settings requested) ----\nCFG = dict(\n    # audio / features\n    sr=16000, duration=5.0, n_mels=128, n_fft=1024, hop_length=256, fmin=50, fmax=8000, top_db=80.0,\n    # split\n    split_seed=42, val_frac=0.15, test_frac=0.15,\n    # training\n    batch_size=32, max_epochs=150, patience=15, num_classes=8,\n    optimizers=[\"Adam\"],\n    learning_rates=[1e-3, 1e-4],\n    seeds=[42, 123, 2024, 7, 2025],\n)\nif SMOKE_TEST:\n    CFG.update(max_epochs=2, patience=2, optimizers=[\"Adam\"], learning_rates=[1e-3], seeds=[42])\n\n# ---- Class definitions (fixed order = class index) ----\nCLASS_NAMES = [\"COPD\", \"Asthma\", \"Pneumonia\", \"Bronchiectasis\", \"Bronchiolitis\", \"URTI\", \"LRTI\", \"Healthy\"]\nCLASS_TO_IDX = {c: i for i, c in enumerate(CLASS_NAMES)}\n# raw CSV label (lower-cased, stripped) -> target class. Anything not listed is reported and excluded.\nLABEL_MAP = {\"copd\": \"COPD\", \"asthma\": \"Asthma\", \"pneumonia\": \"Pneumonia\", \"bronchiectasis\": \"Bronchiectasis\",\n             \"bronchiolitis\": \"Bronchiolitis\", \"urti\": \"URTI\", \"lrti\": \"LRTI\", \"healthy\": \"Healthy\"}\nassert CFG[\"num_classes\"] == len(CLASS_NAMES)\n\n# ---- Output directories (all under /kaggle/working when on Kaggle) ----\nOUT_ROOT = Path(\"/kaggle/working\") if Path(\"/kaggle/working\").exists() else Path(os.environ.get(\"OUT_ROOT\", \"./working\"))\nOUT = OUT_ROOT / (\"resp_cnn_adam_smoke\" if SMOKE_TEST else \"resp_cnn_adam\")\nCACHE_DIR, RUNS_DIR, FIG_DIR, RES_DIR, SPLIT_DIR = (OUT / d for d in [\"cache\", \"runs\", \"figures\", \"results\", \"splits\"])\nfor d in (CACHE_DIR, RUNS_DIR, FIG_DIR, RES_DIR, SPLIT_DIR):\n    d.mkdir(parents=True, exist_ok=True)\n\ndef set_seed(seed: int):\n    \"\"\"Seed every RNG used in the pipeline.\"\"\"\n    random.seed(seed); np.random.seed(seed)\n    torch.manual_seed(seed); torch.cuda.manual_seed_all(seed)\n    os.environ[\"PYTHONHASHSEED\"] = str(seed)\n\nprint(\"Python\", platform.python_version(), \"| torch\", torch.__version__, \"| librosa\", librosa.__version__,\n      \"| numpy\", np.__version__, \"| pandas\", pd.__version__)\nprint(\"Output directory:\", OUT, \"| SMOKE_TEST =\", SMOKE_TEST)\nprint(\"Planned runs:\", len(CFG[\"optimizers\"]) * len(CFG[\"learning_rates\"]) * len(CFG[\"seeds\"]))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-09T12:34:41.542161Z","iopub.execute_input":"2026-11-09T12:34:41.54256Z","iopub.status.idle":"2026-11-09T12:34:48.164742Z","shell.execute_reply.started":"2026-11-09T12:34:41.542524Z","shell.execute_reply":"2026-11-09T12:34:48.163951Z"}},"outputs":[{"name":"stdout","text":"Python 3.13.16 | torch 2.11.0+cu130 | librosa 0.11.0 | numpy 2.1.3 | pandas 2.3.3\nOutput directory: /kaggle/working/resp_cnn_adam | SMOKE_TEST = False\nPlanned runs: 10\n","output_type":"stream"}],"execution_count":1},{"id":"ebc3249f-286f-4976-affa-2626e12615e7","cell_type":"markdown","source":"## 2. GPU Detection and Configuration","metadata":{}},{"id":"d7075049-a527-4738-9b4e-b2eee598de13","cell_type":"code","source":"# ============================================================\n# 2. GPU DETECTION AND CONFIGURATION\n# ============================================================\nDEVICE = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\nprint(\"Device:\", DEVICE)\nif DEVICE.type == \"cuda\":\n    n_gpu = torch.cuda.device_count()\n    for i in range(n_gpu):\n        p = torch.cuda.get_device_properties(i)\n        print(f\"GPU {i}: {p.name} | {p.total_memory / 1024**3:.1f} GB | compute capability {p.major}.{p.minor}\")\n    print(\"CUDA runtime:\", torch.version.cuda, \"| cuDNN:\", torch.backends.cudnn.version())\nelse:\n    print(\"WARNING: no GPU detected. Enable a GPU accelerator in the Kaggle notebook settings; CPU training will be very slow.\")\n\n# Reproducibility settings (bit-exact results are still not guaranteed across different GPU models / library versions)\ntorch.backends.cudnn.benchmark = False\ntorch.backends.cudnn.deterministic = True\ntorch.use_deterministic_algorithms(True, warn_only=True)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-09T12:34:48.165952Z","iopub.execute_input":"2026-11-09T12:34:48.166309Z","iopub.status.idle":"2026-11-09T12:34:52.155333Z","shell.execute_reply.started":"2026-11-09T12:34:48.166287Z","shell.execute_reply":"2026-11-09T12:34:52.154416Z"}},"outputs":[{"name":"stdout","text":"Device: cuda\nGPU 0: Tesla T4 | 14.6 GB | compute capability 7.5\nGPU 1: Tesla T4 | 14.6 GB | compute capability 7.5\nCUDA runtime: 13.0 | cuDNN: 92700\n","output_type":"stream"}],"execution_count":2},{"id":"fac634fd-5e79-4d34-bb7e-ab6ac01801b5","cell_type":"markdown","source":"## 3. Dataset Directory Inspection","metadata":{}},{"id":"b1279430-545c-4c87-a895-8c21005cc1b7","cell_type":"code","source":"# ============================================================\n# 3. DATASET DIRECTORY INSPECTION\n# ============================================================\n# Locate the audio folder and the diagnosis CSV automatically (nothing is hard-coded below /kaggle/input).\nINPUT_ROOT = Path(\"/kaggle/input\") if Path(\"/kaggle/input\").exists() else Path(os.environ.get(\"ICBHI_ROOT\", \".\"))\nprint(\"Searching under:\", INPUT_ROOT.resolve())\n\nprint(\"\\nTop-level contents of the input directory:\")\nfor p in sorted(INPUT_ROOT.iterdir()):\n    print(\"  \", p.name)\n\nall_wavs = list(INPUT_ROOT.rglob(\"*.wav\"))\nif not all_wavs:\n    raise FileNotFoundError(f\"No .wav files found under {INPUT_ROOT}. Did you add the ICBHI dataset to the notebook? \"\n                            \"Please paste the output of `!ls -R /kaggle/input | head -50` so the paths can be fixed.\")\n\n# The audio directory is the folder that holds the most .wav files\ndir_counts = Counter(p.parent for p in all_wavs)\nAUDIO_DIR, n_in_dir = dir_counts.most_common(1)[0]\nprint(f\"\\nAudio directory : {AUDIO_DIR}  ({n_in_dir} wav files)\")\nif len(dir_counts) > 1:\n    print(\"Other folders containing wav files (ignored):\", {str(k): v for k, v in dir_counts.items() if k != AUDIO_DIR})\nprint(\"Annotation .txt files in the same folder:\", len(list(AUDIO_DIR.glob(\"*.txt\"))))\n\ncsv_candidates = sorted(INPUT_ROOT.rglob(\"*.csv\"))\nprint(\"\\nCSV files found:\")\nfor c in csv_candidates:\n    print(\"  \", c)\ndiag_candidates = [c for c in csv_candidates if c.name.lower() == \"patient_diagnosis.csv\"] or \\\n                  [c for c in csv_candidates if \"diagnosis\" in c.name.lower()]\nif not diag_candidates:\n    raise FileNotFoundError(\"patient_diagnosis.csv not found. Please share the dataset structure so the path can be set correctly.\")\nDIAG_CSV = diag_candidates[0]\nprint(\"\\nDiagnosis CSV   :\", DIAG_CSV)\nprint(\"Example wav names:\", [p.name for p in sorted(all_wavs)[:3]])","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-09T12:34:52.156524Z","iopub.execute_input":"2026-11-09T12:34:52.157173Z","iopub.status.idle":"2026-11-09T12:34:53.121367Z","shell.execute_reply.started":"2026-11-09T12:34:52.157147Z","shell.execute_reply":"2026-11-09T12:34:53.120532Z"}},"outputs":[{"name":"stdout","text":"Searching under: /kaggle/input\n\nTop-level contents of the input directory:\n   datasets\n\nAudio directory : /kaggle/input/datasets/vbookshelf/respiratory-sound-database/respiratory_sound_database/Respiratory_Sound_Database/audio_and_txt_files  (920 wav files)\nOther folders containing wav files (ignored): {'/kaggle/input/datasets/vbookshelf/respiratory-sound-database/Respiratory_Sound_Database/Respiratory_Sound_Database/audio_and_txt_files': 920}\nAnnotation .txt files in the same folder: 920\n\nCSV files found:\n   /kaggle/input/datasets/vbookshelf/respiratory-sound-database/Respiratory_Sound_Database/Respiratory_Sound_Database/patient_diagnosis.csv\n   /kaggle/input/datasets/vbookshelf/respiratory-sound-database/respiratory_sound_database/Respiratory_Sound_Database/patient_diagnosis.csv\n\nDiagnosis CSV   : /kaggle/input/datasets/vbookshelf/respiratory-sound-database/Respiratory_Sound_Database/Respiratory_Sound_Database/patient_diagnosis.csv\nExample wav names: ['101_1b1_Al_sc_Meditron.wav', '101_1b1_Pr_sc_Meditron.wav', '102_1b1_Ar_sc_Meditron.wav']\n","output_type":"stream"}],"execution_count":3},{"id":"d7e148f2-1d5a-41a1-a5a8-6a671319f2fc","cell_type":"markdown","source":"## 4. Diagnosis CSV Inspection","metadata":{}},{"id":"63c051a7-e080-42b1-b5f5-00059efc7ad3","cell_type":"code","source":"# ============================================================\n# 4. DIAGNOSIS CSV INSPECTION\n# ============================================================\nprint(\"--- first 5 raw lines of the file ---\")\nwith open(DIAG_CSV, \"r\") as f:\n    for _ in range(5):\n        print(repr(f.readline()))\n\n# The ICBHI file normally has NO header (two columns: patient id, diagnosis). Detect instead of assuming.\nraw = pd.read_csv(DIAG_CSV, header=None)\nfirst_cell = str(raw.iloc[0, 0]).strip()\nif not first_cell.isdigit():\n    print(\"\\nFirst cell is not numeric -> treating first row as a header.\")\n    raw = pd.read_csv(DIAG_CSV, header=0)\nelse:\n    print(\"\\nNo header detected (first cell is numeric).\")\nprint(\"Shape:\", raw.shape, \"| columns:\", list(raw.columns))\nassert raw.shape[1] >= 2, \"Expected at least two columns (patient id, diagnosis).\"\n\ndiag = raw.iloc[:, :2].copy()\ndiag.columns = [\"patient_id\", \"diagnosis_raw\"]\ndiag[\"patient_id\"] = pd.to_numeric(diag[\"patient_id\"], errors=\"coerce\")\nbad_ids = diag[diag[\"patient_id\"].isna()]\nif len(bad_ids):\n    print(f\"WARNING: {len(bad_ids)} diagnosis rows have a non-numeric patient id and are excluded:\\n\", bad_ids)\ndiag = diag.dropna(subset=[\"patient_id\"]).copy()\ndiag[\"patient_id\"] = diag[\"patient_id\"].astype(int)\ndiag[\"diagnosis_raw\"] = diag[\"diagnosis_raw\"].astype(str).str.strip()\n\ndups = diag[diag.duplicated(\"patient_id\", keep=False)]\nif len(dups):\n    conflicting = dups.groupby(\"patient_id\")[\"diagnosis_raw\"].nunique()\n    if (conflicting > 1).any():\n        raise ValueError(f\"Patients with conflicting diagnoses: {list(conflicting[conflicting > 1].index)}\")\n    print(f\"Note: {dups['patient_id'].nunique()} duplicated patient ids with identical diagnoses -> de-duplicated.\")\n    diag = diag.drop_duplicates(\"patient_id\")\n\ndiag[\"label\"] = diag[\"diagnosis_raw\"].str.lower().map(LABEL_MAP)\nprint(\"\\nPatients in CSV:\", len(diag))\nprint(\"\\nRaw diagnosis values (patients per value):\")\nprint(diag[\"diagnosis_raw\"].value_counts().to_string())\n\nunmapped = diag[diag[\"label\"].isna()]\nif len(unmapped):\n    print(f\"\\nWARNING: {len(unmapped)} patients have diagnosis values outside the 8 target classes \"\n          f\"({sorted(unmapped['diagnosis_raw'].unique())}). Their recordings will be excluded and logged.\")\nmissing_classes = [c for c in CLASS_NAMES if c not in set(diag[\"label\"].dropna())]\nif missing_classes:\n    raise RuntimeError(f\"Dataset does not contain target classes: {missing_classes}. Stopping instead of inventing labels.\")\nprint(\"\\nAll 8 target classes are present in the diagnosis CSV.\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-09T12:34:53.123203Z","iopub.execute_input":"2026-11-09T12:34:53.123513Z","iopub.status.idle":"2026-11-09T12:34:53.230077Z","shell.execute_reply.started":"2026-11-09T12:34:53.123456Z","shell.execute_reply":"2026-11-09T12:34:53.229416Z"}},"outputs":[{"name":"stdout","text":"--- first 5 raw lines of the file ---\n'101,URTI\\n'\n'102,Healthy\\n'\n'103,Asthma\\n'\n'104,COPD\\n'\n'105,URTI\\n'\n\nNo header detected (first cell is numeric).\nShape: (126, 2) | columns: [0, 1]\n\nPatients in CSV: 126\n\nRaw diagnosis values (patients per value):\ndiagnosis_raw\nCOPD              64\nHealthy           26\nURTI              14\nBronchiectasis     7\nBronchiolitis      6\nPneumonia          6\nLRTI               2\nAsthma             1\n\nAll 8 target classes are present in the diagnosis CSV.\n","output_type":"stream"}],"execution_count":4},{"id":"20499453-5ea2-4f7e-8d20-5096d30681c9","cell_type":"markdown","source":"## 5. Audio File Loading","metadata":{}},{"id":"0fb4e483-1017-4f50-bb2d-7454f07892c4","cell_type":"code","source":"# ============================================================\n# 5. AUDIO FILE LOADING  (build the recording-level metadata table)\n# ============================================================\n# File names look like  101_1b1_Al_sc_Meditron.wav  ->  patientID_recordingIdx_chestLocation_acqMode_device\ndropped_log = []   # every excluded recording is recorded here WITH a reason\n\nrows = []\nfor p in sorted(AUDIO_DIR.glob(\"*.wav\")):\n    parts = p.stem.split(\"_\")\n    pid = int(parts[0]) if parts[0].isdigit() else None\n    rows.append(dict(file=p.name, path=str(p), patient_id=pid,\n                     chest_loc=parts[2] if len(parts) > 2 else None,\n                     device=parts[4] if len(parts) > 4 else None))\nmeta = pd.DataFrame(rows)\nprint(\"Wav files:\", len(meta))\n\n# (a) patient id could not be parsed\nbad = meta[meta[\"patient_id\"].isna()]\ndropped_log += [dict(file=f, reason=\"patient id not parsable from filename\") for f in bad[\"file\"]]\nmeta = meta.dropna(subset=[\"patient_id\"]).copy()\nmeta[\"patient_id\"] = meta[\"patient_id\"].astype(int)\n\n# (b) patient id not present in the diagnosis CSV\nknown = set(diag[\"patient_id\"])\nnodiag = meta[~meta[\"patient_id\"].isin(known)]\ndropped_log += [dict(file=f, reason=\"patient id missing from diagnosis CSV\") for f in nodiag[\"file\"]]\nmeta = meta[meta[\"patient_id\"].isin(known)].copy()\n\nmeta = meta.merge(diag[[\"patient_id\", \"diagnosis_raw\", \"label\"]], on=\"patient_id\", how=\"left\")\n\n# (c) diagnosis outside the 8 target classes\nunm = meta[meta[\"label\"].isna()]\ndropped_log += [dict(file=f, reason=\"diagnosis not in the 8 target classes\") for f in unm[\"file\"]]\nmeta = meta[meta[\"label\"].notna()].copy().reset_index(drop=True)\nmeta[\"label_idx\"] = meta[\"label\"].map(CLASS_TO_IDX).astype(int)\n\nno_audio = sorted(known - set(meta[\"patient_id\"]))\nprint(f\"Recordings matched to a target-class diagnosis: {len(meta)} | patients: {meta['patient_id'].nunique()}\")\nprint(f\"Patients in the CSV without any (usable) recording: {len(no_audio)} {no_audio[:20]}\")\nprint(f\"Recordings excluded so far: {len(dropped_log)}\")\nif dropped_log:\n    print(pd.DataFrame(dropped_log)[\"reason\"].value_counts().to_string())\n\n# Final check that all 8 classes still exist after matching\nstill_missing = [c for c in CLASS_NAMES if c not in set(meta[\"label\"])]\nif still_missing:\n    raise RuntimeError(f\"After matching recordings to labels these classes have no audio: {still_missing}. Stopping.\")\nmeta.head()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-09T12:34:53.23121Z","iopub.execute_input":"2026-11-09T12:34:53.231527Z","iopub.status.idle":"2026-11-09T12:34:53.293935Z","shell.execute_reply.started":"2026-11-09T12:34:53.231496Z