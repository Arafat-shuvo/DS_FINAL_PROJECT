g_rate']:g}\")\nprint(f\"  Validation Macro-F1 : {best_cfg['best_val_macro_f1_mean']:.4f} ± {best_cfg['best_val_macro_f1_std']:.4f}\")\nfor lab, k in [(\"Accuracy\", \"test_accuracy\"), (\"Macro Precision\", \"test_macro_precision\"), (\"Macro Recall\", \"test_macro_recall\"),\n               (\"Macro-F1\", \"test_macro_f1\"), (\"Macro AUC\", \"test_macro_auc\")]:\n    print(f\"  Held-out test {lab:16s}: {best_cfg[k + '_mean']:.4f} ± {best_cfg[k + '_std']:.4f}\")\n\n# ---- Plots ----\nfig, axes = plt.subplots(1, 3, figsize=(17, 4.8))\nopts, lrs = CFG[\"optimizers\"], CFG[\"learning_rates\"]\nw = 0.8 / len(lrs); x = np.arange(len(opts))\nfor k, lr in enumerate(lrs):                                              # (a) mean ± SD test Macro-F1\n    sub = summary[summary[\"learning_rate\"] == lr].set_index(\"optimizer\").reindex(opts)\n    axes[0].bar(x + k * w, sub[\"test_macro_f1_mean\"], w, yerr=sub[\"test_macro_f1_std\"], capsize=4, label=f\"lr={lr:g}\")\naxes[0].set_xticks(x + w * (len(lrs) - 1) / 2); axes[0].set_xticklabels(opts)\naxes[0].set_title(\"Test Macro-F1 (mean ± SD over seeds)\"); axes[0].set_ylabel(\"Macro-F1\"); axes[0].set_xlabel(\"Optimizer\"); axes[0].legend()\n\nlabels, data = [], []                                                      # (b) per-seed distribution\nfor o in opts:\n    for lr in lrs:\n        d = results_df[(results_df[\"optimizer\"] == o) & (results_df[\"learning_rate\"] == lr)][\"test_macro_f1\"].values\n        if len(d): labels.append(f\"{o}\\n{lr:g}\"); data.append(d)\naxes[1].boxplot(data, showmeans=True); axes[1].set_xticks(range(1, len(labels) + 1)); axes[1].set_xticklabels(labels)\nfor i, d in enumerate(data, 1): axes[1].scatter(np.full(len(d), i), d, color=\"k\", s=12, zorder=3)\naxes[1].set_title(\"Test Macro-F1 per seed\"); axes[1].set_ylabel(\"Macro-F1\"); axes[1].set_xlabel(\"Optimizer / learning rate\")\n\nfor k, lr in enumerate(lrs):                                              # (c) validation vs test (selection vs gen