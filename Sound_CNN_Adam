itron.wav</td>\n      <td>/kaggle/input/datasets/vbookshelf/respiratory-...</td>\n      <td>101</td>\n      <td>Al</td>\n      <td>Meditron</td>\n      <td>URTI</td>\n      <td>URTI</td>\n      <td>5</td>\n    </tr>\n    <tr>\n      <th>1</th>\n      <td>101_1b1_Pr_sc_Meditron.wav</td>\n      <td>/kaggle/input/datasets/vbookshelf/respiratory-...</td>\n      <td>101</td>\n      <td>Pr</td>\n      <td>Meditron</td>\n      <td>URTI</td>\n      <td>URTI</td>\n      <td>5</td>\n    </tr>\n    <tr>\n      <th>2</th>\n      <td>102_1b1_Ar_sc_Meditron.wav</td>\n      <td>/kaggle/input/datasets/vbookshelf/respiratory-...</td>\n      <td>102</td>\n      <td>Ar</td>\n      <td>Meditron</td>\n      <td>Healthy</td>\n      <td>Healthy</td>\n      <td>7</td>\n    </tr>\n    <tr>\n      <th>3</th>\n      <td>103_2b2_Ar_mc_LittC2SE.wav</td>\n      <td>/kaggle/input/datasets/vbookshelf/respiratory-...</td>\n      <td>103</td>\n      <td>Ar</td>\n      <td>LittC2SE</td>\n      <td>Asthma</td>\n      <td>Asthma</td>\n      <td>1</td>\n    </tr>\n    <tr>\n      <th>4</th>\n      <td>104_1b1_Al_sc_Litt3200.wav</td>\n      <td>/kaggle/input/datasets/vbookshelf/respiratory-...</td>\n      <td>104</td>\n      <td>Al</td>\n      <td>Litt3200</td>\n      <td>COPD</td>\n      <td>COPD</td>\n      <td>0</td>\n    </tr>\n  </tbody>\n</table>\n</div>"},"metadata":{}}],"execution_count":5},{"id":"356bc02d-9555-4107-8f9d-03c55e9079ad","cell_type":"markdown","source":"## 6. Audio Preprocessing","metadata":{}},{"id":"9eab3b57-fcaa-46e1-a1c6-36d8399b700e","cell_type":"code","source":"# ============================================================\n# 6. AUDIO PREPROCESSING\n# ============================================================\nTARGET_LEN = int(CFG[\"sr\"] * CFG[\"duration\"])   # 80,000 samples\n\ndef load_and_preprocess(path: str) -> np.ndarray:\n    \"\"\"Load -> mono -> resample to 16 kHz -> remove DC offset -> peak-normalise -> pad/truncate to 5 s.\n    Raises ValueError for unreadable, empty, non-finite or silent audio (caller logs the reason).\"\"\"\n    y, _ = librosa.load(path, sr=CFG[\"sr\"], mono=True)           # librosa resamples to CFG['sr']\n    if y.size == 0:\n        raise ValueError(\"empty audio\")\n    if not np.all(np.isfinite(y)):\n        raise ValueError(\"non-finite samples\")\n    y = y - np.mean(y)                                            # remove DC offset\n    peak = np.max(np.abs(y))\n    if peak < 1e-8:\n        raise ValueError(\"silent audio\")\n    y = y / peak                                                  # peak normalisation to [-1, 1]\n    if y.size >= TARGET_LEN:                                      # truncate (keep the first 5 s)\n        y = y[:TARGET_LEN]\n    else:                                                         # zero-pad at the end\n        y = np.pad(y, (0, TARGET_LEN - y.size))\n    return y.astype(np.float32)\n\n# quick sanity check on one file\n_y = load_and_preprocess(meta.loc[0, \"path\"])\nprint(\"Example:\", meta.loc[0, \"file\"], \"| shape:\", _y.shape, \"| min/max:\", _y.min(), _y.max(), \"| dtype:\", _y.dtype)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-09T12:34:53.294813Z","iopub.execute_input":"2026-11-09T12:34:53.29507Z","iopub.status.idle":"2026-11-09T12:35:08.172239Z","shell.execute_reply.started":"2026-11-09T12:34:53.29505Z","shell.execute_reply":"2026-11-09T12:35:08.171319Z"}},"outputs":[{"name":"stdout","text":"Example: 101_1b1_Al_sc_Meditron.wav | shape: (80000,) | min/max: -0.48244202 1.0 | dtype: float32\n","output_type":"stream"}],"execution_count":6},{"id":"44716e5e-7b49-4d59-b42d-e208e73141b1","cell_type":"markdown","source":"## 7. Log-Mel Spectrogram Generation","metadata":{}},{"id":"24c5f7cb-4803-4995-9074-4a4f8aeee383","cell_type":"code","source":"# ============================================================\n# 7. LOG-MEL SPECTROGRAM GENERATION  (cached to disk)\n# ============================================================\ndef logmel(y: np.ndarray) -> np.ndarray:\n    \"\"\"Power mel spectrogram -> decibel scale. Output shape: (n_mels, frames) = (128, 313).\"\"\"\n    S = librosa.feature.melspectrogram(y=y, sr=CFG[\"sr\"], n_fft=CFG[\"n_fft\"], hop_length=CFG[\"hop_length\"],\n                                       n_mels=CFG[\"n_mels\"], fmin=CFG[\"fmin\"], fmax=CFG[\"fmax\"], power=2.0)\n    return librosa.power_to_db(S, ref=np.max, top_db=CFG[\"top_db\"]).astype(np.float32)\n\n# cache key depends on the feature config and the exact file list -> stale caches are never reused\nfeat_cfg = {k: CFG[k] for k in [\"sr\", \"duration\", \"n_mels\", \"n_fft\", \"hop_length\", \"fmin\", \"fmax\", \"top_db\"]}\nsig = hashlib.md5((json.dumps(feat_cfg, sort_keys=True) + \"|\".join(meta[\"file\"])).encode()).hexdigest()[:10]\nCACHE_FILE = CACHE_DIR / f\"logmel_{sig}.npz\"\nDROP_FILE = CACHE_DIR / f\"dropped_{sig}.json\"\n\nif CACHE_FILE.exists():\n    z = np.load(CACHE_FILE, allow_pickle=False)\n    X_all, good_files = z[\"X\"], list(z[\"files\"])\n    dropped_log = json.load(open(DROP_FILE))\n    print(f\"Loaded cached features: {X_all.shape} from {CACHE_FILE.name}\")\nelse:\n    feats, good_files = [], []\n    for f, p in tqdm(list(zip(meta[\"file\"], meta[\"path\"])), desc=\"Log-Mel extraction\"):\n        try:\n            feats.append(logmel(load_and_preprocess(p)))\n            good_files.append(f)\n        except Exception as e:                                    # corrupted / unreadable / silent file\n            dropped_log.append(dict(file=f, reason=f\"audio error: {type(e).__name__}: {e}\"))\n    X_all = np.stack(feats).astype(np.float32)\n    np.savez(CACHE_FILE, X=X_all, files=np.array(good_files))\n    json.dump(dropped_log, open(DROP_FILE, \"w\"))\n    print(f\"Computed and cached features: {X_all.shape} -> {CACHE_FILE.name}\")\n\n# keep metadata aligned with the feature array\nmeta = meta.set_index(\"file\").loc[good_files].reset_index()\nassert len(meta) == len(X_all)\ndropped_df = pd.DataFrame(dropped_log, columns=[\"file\", \"reason\"])\ndropped_df.to_csv(RES_DIR / \"excluded_recordings.csv\", index=False)\nprint(f\"\\nUsable recordings: {len(meta)} | excluded: {len(dropped_df)}\")\nif len(dropped_df):\n    print(dropped_df[\"reason\"].value_counts().to_string())\n\n# Visual sanity check\nfig, ax = plt.subplots(figsize=(8, 3.5))\nim = ax.imshow(X_all[0], origin=\"lower\", aspect=\"auto\", cmap=\"magma\")\nax.set_title(f\"Log-Mel spectrogram — {meta.loc[0, 'file']} ({meta.loc[0, 'label']})\")\nax.set_xlabel(\"Frame\"); ax.set_ylabel(\"Mel band\"); fig.colorbar(im, ax=ax, label=\"dB\")\nfig.tight_layout(); fig.savefig(FIG_DIR / \"example_logmel.png\", dpi=150); plt.show()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-09T12:35:08.173451Z","iopub.execute_input":"2026-11-09T12:35:08.17383Z","iopub.status.idle":"2026-11-09T12:36:53.095782Z","shell.execute_reply.started":"2026-11-09T12:35:08.173795Z","shell.execute_reply":"2026-11-09T12:36:53.09502Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"Log-Mel extraction:   0%|          | 0/920 [00:00<?, ?it/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"a30f92b0b6ed425c95467224ae3ecc65"}},"metadata":{}},{"name":"stdout","text":"Computed and cached features: (920, 128, 313) -> logmel_096b0fdd23.npz\n\nUsable recordings: 920 | excluded: 0\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"<Figure size 800x350 with 2 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":7},{"id":"7d1fbb4e-9cef-4528-8e62-fb347273eaa4","cell_type":"markdown","source":"## 8. Dataset and Class Distribution Analysis","metadata":{}},{"id":"3c088d96-7411-4d00-af51-88e8dede4b34","cell_type":"code","source":"# ============================================================\n# 8. DATASET AND CLASS DISTRIBUTION ANALYSIS\n# ============================================================\ndist = pd.DataFrame({\n    \"recordings\": meta[\"label\"].value_counts().reindex(CLASS_NAMES).fillna(0).astype(int),\n    \"patients\": meta.groupby(\"label\")[\"patient_id\"].nunique().reindex(CLASS_NAMES).fillna(0).astype(int),\n})\ndist[\"recordings_%\"] = (100 * dist[\"recordings\"] / dist[\"recordings\"].sum()).round(1)\nprint(\"Class distribution BEFORE splitting\")\ndisplay(dist)\nprint(f\"Total: {dist['recordings'].sum()} recordings from {dist['patients'].sum()} patients\")\n\nfig, axes = plt.subplots(1, 2, figsize=(12, 4))\ndist[\"recordings\"].plot.bar(ax=axes[0], color=\"steelblue\"); axes[0].set_title(\"Recordings per class\")\ndist[\"patients\"].plot.bar(ax=axes[1], color=\"darkorange\");  axes[1].set_title(\"Patients per class\")\nfor a in axes: a.set_ylabel(\"Count\"); a.set_xlabel(\"Class\"); a.tick_params(axis=\"x\", rotation=45)\nfig.tight_layout(); fig.savefig(FIG_DIR / \"class_distribution.png\", dpi=150); plt.show()\n\nfew = dist[dist[\"patients\"] < 3]\nif len(few):\n    print(\"NOTE: classes with fewer than 3 patients cannot appear in train, validation AND test at the same time \"\n          \"under a patient-independent split:\\n\", few[[\"patients\"]].to_string())","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-09T12:36:53.09736Z","iopub.execute_input":"2026-11-09T12:36:53.098074Z","iopub.status.idle":"2026-11-09T12:36:53.902228Z","shell.execute_reply.started":"2026-11-09T12:36:53.09805Z","shell.execute_reply":"2026-11-09T12:36:53.901617Z"}},"outputs":[{"name":"stdout","text":"Class distribution BEFORE splitting\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"                recordings  patients  recordings_%\nlabel                                             \nCOPD                   793        64          86.2\nAsthma                   1         1           0.1\nPneumonia               37         6           4.0\nBronchiectasis          16         7           1.7\nBronchiolitis           13         6           1.4\nURTI                    23        14           2.5\nLRTI                     2         2           0.2\nHealthy                 35        26           3.8","text/html":"<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th></th>\n      <th>recordings</th>\n      <th>patients</th>\n      <th>recordings_%</th>\n    </tr>\n    <tr>\n      <th>label</th>\n      <th></th>\n      <th></th>\n      <th></th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th>COPD</th>\n      <td>793</td>\n      <td>64</td>\n      <td>86.2</td>\n    </tr>\n    <tr>\n      <th>Asthma</th>\n      <td>1</td>\n      <td>1</td>\n      <td>0.1</td>\n    </tr>\n    <tr>\n      <th>Pneumonia</th>\n      <td>37</td>\n      <td>6</td>\n      <td>4.0</td>\n    </tr>\n    <tr>\n      <th>Bronchiectasis</th>\n      <td>16</td>\n      <td>7</td>\n      <td>1.7</td>\n    </tr>\n    <tr>\n      <th>Bronchiolitis</th>\n      <td>13</td>\n      <td>6</td>\n      <td>1.4</td>\n    </tr>\n    <tr>\n      <th>URTI</th>\n      <td>23</td>\n      <td>14</td>\n      <td>2.5</td>\n    </tr>\n    <tr>\n      <th>LRTI</th>\n      <td>2</td>\n      <td>2</td>\n      <td>0.2</td>\n    </tr>\n    <tr>\n      <th>Healthy</th>\n      <td>35</td>\n      <td>26</td>\n      <td>3.8</td>\n    </tr>\n  </tbody>\n</table>\n</div>"},"metadata":{}},{"name":"stdout","text":"Total: 920 recordings from 126 patients\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"<Figure size 1200x400 with 2 Axes>","image/png":"\n"},"metadata":{}},{"name":"stdout","text":"NOTE: classes with fewer than 3 patients cannot appear in train, validation AND test at the same time under a patient-independent split:\n         patients\nlabel           \nAsthma         1\nLRTI           2\n","output_type":"stream"}],"execution_count":8},{"id":"ba5eb819-276c-40b8-b01f-39b14fe17280","cell_type":"markdown","source":"## 9. Patient-Independent Data Splitting","metadata":{}},{"id":"494a72cf-f3b8-4f57-af51-242e2a38eff6","cell_type":"code","source":"# ============================================================\n# 9. PATIENT-INDEPENDENT DATA SPLITTING (fixed for all 40 runs)\n# ============================================================\n# Method: each patient has exactly one diagnosis, so the split is done at the PATIENT level and allocated\n# class-by-class (i.e. stratified by patient diagnosis). For a class with n patients:\n#   n >= 3 : n_val = n_test = max(1, round(0.15 n)), remainder -> train\n#   n == 2 : 1 train, 0 val, 1 test      n == 1 : 1 train\n# Percentages are therefore approximate at the recording level (patients differ greatly in recording count).\ndef patient_split(patients_df, seed, val_frac, test_frac):\n    rng = np.random.RandomState(seed)\n    assign = {}\n    for label, grp in patients_df.groupby(\"label\"):\n        ids = np.array(sorted(grp[\"patient_id\"]))\n        rng.shuffle(ids)\n        n = len(ids)\n        if n >= 3:\n            n_val = max(1, int(np.floor(val_frac * n + 0.5)))\n            n_test = max(1, int(np.floor(test_frac * n + 0.5)))\n        elif n == 2:\n            n_val, n_test = 0, 1\n        else:\n            n_val, n_test = 0, 0\n        for i, pid in enumerate(ids):\n            assign[int(pid)] = \"test\" if i < n_test else (\"val\" if i < n_test + n_val else \"train\")\n    return assign\n\npatients = meta.drop_duplicates(\"patient_id\")[[\"patient_id\", \"label\"]]\nassert patients[\"patient_id\"].is_unique\nassign = patient_split(patients, CFG[\"split_seed\"], CFG[\"val_frac\"], CFG[\"test_frac\"])\nmeta[\"split\"] = meta[\"patient_id\"].map(assign)\nassert meta[\"split\"].notna().all()\n\n# ---- Leakage check ----\nids = {s: set(meta.loc[meta[\"split\"] == s, \"patient_id\"]) for s in [\"train\", \"val\", \"test\"]}\nassert not (ids[\"train\"] & ids[\"val\"]) and not (ids[\"train\"] & ids[\"test\"]) and not (ids[\"val\"] & ids[\"test\"]), \"PATIENT LEAKAGE!\"\nprint(\"Leakage check passed: no patient appears in more than one split.\\n\")\n\nfor s in [\"train\", \"val\", \"test\"]:\n    n_rec = int((meta[\"split\"] == s).sum())\n    print(f\"{s.upper():5s}: {len(ids[s]):3d} patients ({100*len(ids[s])/len(patients):.1f}% of patients) | \"\n          f\"{n_rec:4d} recordings ({100*n_rec/len(meta):.1f}% of recordings)\")\n    print(\"       patient IDs:\", sorted(ids[s]))\n\npt_dist = pd.crosstab(meta.drop_duplicates(\"patient_id\")[\"label\"], meta.drop_duplicates(\"patient_id\")[\"split\"]).reindex(index=CLASS_NAMES, columns=[\"train\", \"val\", \"test\"]).fillna(0).astype(int)\nrec_dist = pd.crosstab(meta[\"label\"], meta[\"split\"]).reindex(index=CLASS_NAMES, columns=[\"train\", \"val\", \"test\"]).fillna(0).astype(int)\nprint(\"\\nPatients per class per split\"); display(pt_dist)\nprint(\"Recordings per class per split\"); display(rec_dist)\n\nabsent = {s: [c for c in CLASS_NAMES if rec_dist.loc[c, s] == 0] for s in [\"train\", \"val\", \"test\"]}\nfor s, a in absent.items():\n    print(f\"Classes absent from {s}: {a if a else 'none'}\")\nprint(\"\\nMetrics for classes absent from the validation / test set are reported as undefined; macro averages use only classes with support.\")\n\nmeta[[\"file\", \"patient_id\", \"label\", \"split\"]].to_csv(SPLIT_DIR / \"split_assignment.csv\", index=False)\npt_dist.to_csv(SPLIT_DIR / \"patients_per_class_per_split.csv\"); rec_dist.to_csv(SPLIT_DIR / \"recordings_per_class_per_split.csv\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-09T12:36:53.903754Z","iopub.execute_input":"2026-11-09T12:36:53.90437Z","iopub.status.idle":"2026-11-09T12:36:53.970202Z","shell.execute_reply.started":"2026-11-09T12:36:53.904348Z","shell.execute_reply":"2026-11-09T12:36:53.969598