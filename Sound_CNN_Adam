/td>\n      <td>102</td>\n      <td>82</td>\n    </tr>\n    <tr>\n      <th>Asthma</th>\n      <td>1</td>\n      <td>0</td>\n      <td>0</td>\n    </tr>\n    <tr>\n      <th>Pneumonia</th>\n      <td>21</td>\n      <td>3</td>\n      <td>13</td>\n    </tr>\n    <tr>\n      <th>Bronchiectasis</th>\n      <td>12</td>\n      <td>2</td>\n      <td>2</td>\n    </tr>\n    <tr>\n      <th>Bronchiolitis</th>\n      <td>9</td>\n      <td>3</td>\n      <td>1</td>\n    </tr>\n    <tr>\n      <th>URTI</th>\n      <td>19</td>\n      <td>2</td>\n      <td>2</td>\n    </tr>\n    <tr>\n      <th>LRTI</th>\n      <td>1</td>\n      <td>0</td>\n      <td>1</td>\n    </tr>\n    <tr>\n      <th>Healthy</th>\n      <td>27</td>\n      <td>4</td>\n      <td>4</td>\n    </tr>\n  </tbody>\n</table>\n</div>"},"metadata":{}},{"name":"stdout","text":"Classes absent from train: none\nClasses absent from val: ['Asthma', 'LRTI']\nClasses absent from test: ['Asthma']\n\nMetrics for classes absent from the validation / test set are reported as undefined; macro averages use only classes with support.\n","output_type":"stream"}],"execution_count":9},{"id":"42a48e5e-94fd-4568-9785-10e7fe50d7fd","cell_type":"markdown","source":"## 10. PyTorch Dataset and DataLoader","metadata":{}},{"id":"7a1986b9-0ec6-4b58-9365-809c2cc97961","cell_type":"code","source":"# ============================================================\n# 10. PYTORCH DATASET AND DATALOADER\n# ============================================================\n# Features live in CPU RAM (~150 MB); only mini-batches are moved to the GPU.\ntrain_mask = (meta[\"split\"] == \"train\").values\n# Normalisation statistics come from the TRAINING split only (no val/test leakage)\nFEAT_MEAN, FEAT_STD = float(X_all[train_mask].mean()), float(X_all[train_mask].std() + 1e-8)\nprint(f\"Train-set feature mean={FEAT_MEAN:.3f}, std={FEAT_STD:.3f}\")\n\nX_t = torch.from_numpy((X_all - FEAT_MEAN) / FEAT_STD).unsqueeze(1)          # (N, 1, 128, 313)\ny_t = torch.from_numpy(meta[\"label_idx\"].values).long()\nSPLIT_IDX = {s: torch.from_numpy(np.where(meta[\"split\"].values == s)[0]) for s in [\"train\", \"val\", \"test\"]}\nSPLIT_DS = {s: TensorDataset(X_t[idx], y_t[idx]) for s, idx in SPLIT_IDX.items()}\nINPUT_SHAPE = tuple(X_t.shape[1:])\nprint(\"Input shape per sample:\", INPUT_SHAPE, \"| samples:\", {s: len(d) for s, d in SPLIT_DS.items()})\n\ndef make_loader(split: str, seed: int, shuffle: bool = False) -> DataLoader:\n    \"\"\"Deterministic loader: shuffling order depends only on the run seed.\"\"\"\n    g = torch.Generator(); g.manual_seed(seed)\n    return DataLoader(SPLIT_DS[split], batch_size=CFG[\"batch_size\"], shuffle=shuffle, generator=g,\n                      num_workers=0, pin_memory=(DEVICE.type == \"cuda\"), drop_last=False)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-09T12:36:53.972235Z","iopub.execute_input":"2026-11-09T12:36:53.972546Z","iopub.status.idle":"2026-11-09T12:36:54.297121Z","shell.execute_reply.started":"2026-11-09T12:36:53.972525Z","shell.execute_reply":"2026-11-09T12:36:54.296471Z"}},"outputs":[{"name":"stdout","text":"Train-set feature mean=-59.603, std=15.766\nInput shape per sample: (1, 128, 313) | samples: {'train': 699, 'val': 116, 'test': 105}\n","output_type":"stream"}],"execution_count":10},{"id":"459a6e2b-a659-45be-a171-cba5c8c7470d","cell_type":"markdown","source":"## 11. Basic CNN Architecture","metadata":{}},{"id":"e56dd8dc-bc76-43d6-9a27-fd4ceb3c3581","cell_type":"code","source":"# ============================================================\n# 11. BASIC CNN ARCHITECTURE\n# ============================================================\nclass BasicCNN(nn.Module):\n    def __init__(self, n_classes: int = 8, channels=(32, 64, 128, 256), fc_dim: int = 128, dropout: float = 0.5):\n        super().__init__()\n        blocks, in_ch = [], 1\n        for out_ch in channels:                                    # 4 x (Conv + BN + ReLU + MaxPool)\n            blocks += [nn.Conv2d(in_ch, out_ch, kernel_size=3, padding=1),\n                       nn.BatchNorm2d(out_ch), nn.ReLU(inplace=True), nn.MaxPool2d(2)]\n            in_ch = out_ch\n        self.features = nn.Sequential(*blocks)\n        self.pool = nn.AdaptiveAvgPool2d((1, 1))\n        self.classifier = nn.Sequential(nn.Flatten(), nn.Linear(in_ch, fc_dim), nn.ReLU(inplace=True),\n                                        nn.Dropout(dropout), nn.Linear(fc_dim, n_classes))\n    def forward(self, x):\n        return self.classifier(self.pool(self.features(x)))\n\ndef count_params(m): return sum(p.numel() for p in m.parameters() if p.requires_grad)\n\n_m = BasicCNN(CFG[\"num_classes\"])\nprint(_m)\nprint(f\"\\nTrainable parameters: {count_params(_m):,}\")\nwith torch.no_grad():\n    print(\"Output shape for a dummy batch:\", tuple(_m.eval()(torch.zeros(2, *INPUT_SHAPE)).shape))\ndel _m","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-09T12:36:54.298117Z","iopub.execute_input":"2026-11-09T12:36:54.298359Z","iopub.status.idle":"2026-11-09T12:36:54.523572Z","shell.execute_reply.started":"2026-11-09T12:36:54.298338Z","shell.execute_reply":"2026-11-09T12:36:54.52256Z"}},"outputs":[{"name":"stdout","text":"BasicCNN(\n  (features): Sequential(\n    (0): Conv2d(1, 32, kernel_size=(3, 3), stride=(1, 1), padding=(1, 1))\n    (1): BatchNorm2d(32, eps=1e-05, momentum=0.1, affine=True, track_running_stats=True)\n    (2): ReLU(inplace=True)\n    (3): MaxPool2d(kernel_size=2, stride=2, padding=0, dilation=1, ceil_mode=False)\n    (4): Conv2d(32, 64, kernel_size=(3, 3), stride=(1, 1), padding=(1, 1))\n    (5): BatchNorm2d(64, eps=1e-05, momentum=0.1, affine=True, track_running_stats=True)\n    (6): ReLU(inplace=True)\n    (7): MaxPool2d(kernel_size=2, stride=2, padding=0, dilation=1, ceil_mode=False)\n    (8): Conv2d(64, 128, kernel_size=(3, 3), stride=(1, 1), padding=(1, 1))\n    (9): BatchNorm2d(128, eps=1e-05, momentum=0.1, affine=True, track_running_stats=True)\n    (10): ReLU(inplace=True)\n    (11): MaxPool2d(kernel_size=2, stride=2, padding=0, dilation=1, ceil_mode=False)\n    (12): Conv2d(128, 256, kernel_size=(3, 3), stride=(1, 1), padding=(1, 1))\n    (13): BatchNorm2d(256, eps=1e-05, momentum=0.1, affine=True, track_running_stats=True)\n    (14): ReLU(inplace=True)\n    (15): MaxPool2d(kernel_size=2, stride=2, padding=0, dilation=1, ceil_mode=False)\n  )\n  (pool): AdaptiveAvgPool2d(output_size=(1, 1))\n  (classifier): Sequential(\n    (0): Flatten(start_dim=1, end_dim=-1)\n    (1): Linear(in_features=256, out_features=128, bias=True)\n    (2): ReLU(inplace=True)\n    (3): Dropout(p=0.5, inplace=False)\n    (4): Linear(in_features=128, out_features=8, bias=True)\n  )\n)\n\nTrainable parameters: 422,728\nOutput shape for a dummy batch: (2, 8)\n","output_type":"stream"}],"execution_count":11},{"id":"cecbe820-02fc-4557-a28b-c4b6c408ca45","cell_type":"markdown","source":"## 12. Training and Validation Functions","metadata":{}},{"id":"9073b8a5-0cf4-40c3-b0df-c92beab3b990","cell_type":"code","source":"# ============================================================\n# 12. TRAINING AND VALIDATION FUNCTIONS\n# ============================================================\ndef make_optimizer(name: str, params, lr: float):\n    if name == \"Adam\":    return torch.optim.Adam(params, lr=lr)\n    if name == \"AdamW\":   return torch.optim.AdamW(params, lr=lr)\n    if name == \"SGD\":     return torch.optim.SGD(params, lr=lr, momentum=0.9)\n    if name == \"RMSprop\": return torch.optim.RMSprop(params, lr=lr)\n    raise ValueError(name)\n\ndef train_one_epoch(model, loader, optimizer, criterion):\n    model.train()\n    total_loss, correct, n = 0.0, 0, 0\n    for xb, yb in loader:\n        xb, yb = xb.to(DEVICE, non_blocking=True), yb.to(DEVICE, non_blocking=True)\n        optimizer.zero_grad(set_to_none=True)\n        out = model(xb)\n        loss = criterion(out, yb)\n        loss.backward()\n        optimizer.step()\n        total_loss += loss.item() * xb.size(0)\n        correct += (out.argmax(1) == yb).sum().item()\n        n += xb.size(0)\n    return total_loss / n, correct / n\n\n@torch.no_grad()\ndef evaluate(model, loader, criterion):\n    model.eval()\n    total_loss, n = 0.0, 0\n    ys, preds, probs = [], [], []\n    for xb, yb in loader:\n        xb, yb = xb.to(DEVICE, non_blocking=True), yb.to(DEVICE, non_blocking=True)\n        out = model(xb)\n        total_loss += criterion(out, yb).item() * xb.size(0)\n        n += xb.size(0)\n        ys.append(yb.cpu()); preds.append(out.argmax(1).cpu()); probs.append(torch.softmax(out, 1).cpu())\n    y = torch.cat(ys).numpy(); p = torch.cat(preds).numpy(); pr = torch.cat(probs).numpy()\n    return total_loss / n, float((y == p).mean()), y, p, pr\n\ndef to_cpu(obj):\n    \"\"\"Detached CPU copy of (nested) tensors, used to snapshot the best checkpoint.\"\"\"\n    if torch.is_tensor(obj): return obj.detach().cpu().clone()\n    if isinstance(obj, dict): return {k: to_cpu(v) for k, v in obj.items()}\n    if isinstance(obj, (list, tuple)): return type(obj)(to_cpu(v) for v in obj)\n    return copy.deepcopy(obj)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-09T12:36:54.524898Z","iopub.execute_input":"2026-11-09T12:36:54.525304Z","iopub.status.idle":"2026-11-09T12:36:54.536213Z","shell.execute_reply.started":"2026-11-09T12:36:54.525275Z","shell.execute_reply":"2026-11-09T12:36:54.535536Z"}},"outputs":[],"execution_count":12},{"id":"028201ef-d38b-4e68-83f5-96bf5ab0ba8f","cell_type":"markdown","source":"## 13. Early Stopping Implementation","metadata":{}},{"id":"87e7a586-cd4f-4b51-b651-3ce39e05c0cf","cell_type":"code","source":"# ============================================================\n# 13. EARLY STOPPING (monitors validation Macro-F1, mode = max)\n# ============================================================\nclass EarlyStopping:\n    \"\"\"Stops when the monitored score has not strictly improved for `patience` consecutive epochs.\n    Keeps an in-memory snapshot (model + optimizer state) of the best epoch.\"\"\"\n    def __init__(self, patience: int):\n        self.patience, self.best_score, self.best_epoch = patience, -np.inf, 0\n        self.counter, self.should_stop = 0, False\n        self.best_model_state, self.best_opt_state = None, None\n    def step(self, score, epoch, model, optimizer) -> bool:\n        if score > self.best_score:\n            self.best_score, self.best_epoch, self.counter = score, epoch, 0\n            self.best_model_state, self.best_opt_state = to_cpu(model.state_dict()), to_cpu(optimizer.state_dict())\n            return True\n        self.counter += 1\n        self.should_stop = self.counter >= self.patience\n        return False","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-09T12:36:54.537647Z","iopub.execute_input":"2026-11-09T12:36:54.538202Z","iopub.status.idle":"2026-11-09T12:36:54.553338Z","shell.execute_reply.started":"2026-11-09T12:36:54.53817Z","shell.execute_reply":"2026-11-09T12:36:54.552506Z"}},"outputs":[],"execution_count":13},{"id":"d0c65254-b223-4e53-ab5f-af136476e7af","cell_type":"markdown","source":"## 14. Evaluation Metrics (and the single-experiment runner)","metadata":{}},{"id":"1829fc88-8402-446c-8e67-59cdcac4d375","cell_type":"code","source":"# ============================================================\n# 14. EVALUATION METRICS + EXPERIMENT RUNNER\n# ============================================================\ndef compute_metrics(y_true, y_pred, y_prob=None, n_classes=8):\n    \"\"\"All metrics derived from the 8x8 confusion matrix.\n    - Class-wise precision is undefined (NaN) if the class was never predicted; recall is undefined if the class has no true samples.\n    - Macro averages use ONLY classes with support>0 in y_true (precision of a supported-but-never-predicted class counts as 0).\n    - Macro AUC (one-vs-rest) averages the per-class AUCs that are mathematically defined (class present AND at least one other class present).\"\"\"\n    cm = confusion_matrix(y_true, y_pred, labels=list(range(n_classes)))\n    tp = np.diag(cm).astype(float); sup = cm.sum(1).astype(float); pc = cm.sum(0).astype(float)\n    fp, fn = pc - tp, sup - tp\n    with np.errstate(divide=\"ignore\", invalid=\"ignore\"):\n        prec = np.where(pc > 0, tp / pc, np.nan)\n        rec = np.where(sup > 0, tp / sup, np.nan)\n        den = 2 * tp + fp + fn\n        f1 = np.where(den > 0, 2 * tp / den, np.nan)\n    present = sup > 0\n    out = dict(accuracy=float(tp.sum() / cm.sum()),\n               macro_precision=float(np.mean(np.nan_to_num(prec[present], nan=0.0))),\n               macro_recall=float(np.mean(rec[present])),\n               macro_f1=float(np.mean(f1[present])),\n               n_classes_evaluated=int(present.sum()), cm=cm, prec=prec, rec=rec, f1=f1, support=sup)\n    aucs = np.full(n_classes, np.nan)\n    if y_prob is not None:\n        for c in range(n_classes):\n            pos = (np.asarray(y_true) == c)\n            if 0 < pos.sum() < len(pos):\n                aucs[c] = roc_auc_score(pos, y_prob[:, c])\n    out[\"auc_per_class\"] = aucs\n    out[\"macro_auc\"] = float(np.nanmean(aucs)) if np.isfinite(aucs).any() else float(\"nan\")\n    out[\"n_auc_classes\"] = int(np.isfinite(aucs).sum())\n    return out\n\ndef run_experiment(opt_name: str, lr: float, seed: int) -> dict:\n    run_id = f\"{opt_name}_lr{lr:g}_seed{seed}\"\n    rdir = RUNS_DIR / run_id\n    if (rdir / \"result.json\").exists():                          # resume support: skip finished runs\n        return json.load(open(rdir / \"result.json\"))\n    rdir.mkdir(parents=True, exist_ok=True)\n\n    set_seed(seed)\n    model = BasicCNN(CFG[\"num_classes\"]).to(DEVICE)              # fresh model for every run\n    optimizer = make_optimizer(opt_name, model.parameters(), lr)\n    criterion = nn.CrossEntropyLoss()                            # no class weights (nothing unreported)\n    tr_loader, va_loader, te_loader = make_loader(\"train\", seed, True), make_loader(\"val\", seed), make_loader(\"test\", seed)\n    stopper, history = EarlyStopping(CFG[\"patience\"]), []\n\n    t0 = time.time()\n    for epoch in range(1, CFG[\"max_epochs\"] + 1):\n        tr_loss, tr_acc = train_one_epoch(model, tr_loader, optimizer, criterion)\n        va_loss, va_acc, yv, pv, _ = evaluate(model, va_loader, criterion)\n        vm = compute_metrics(yv, pv, None, CFG[\"num_classes\"])\n        history.append(dict(optimizer=opt_name, learning_rate=lr, seed=seed, epoch=epoch,\n                            train_loss=tr_loss, train_acc=tr_acc, val_loss=va_loss, val_acc=va_acc, val_macro_f1=vm[\"macro_f1\"]))\n        stopper.step(vm[\"macro_f1\"], epoch, model, optimizer)\n        if stopper.should_stop: break\n    train_time = time.time() - t0\n\n    # ---- restore best checkpoint (selected on validation Macro-F1) and evaluate ONCE on the held-out test set ----\n    model.load_state_dict(stopper.best_model_state)\n    te_loss, _, yt, pt, prt = evaluate(model, te_loader, criterion)\n    tm = compute_metrics(yt, pt, prt, CFG[\"num_classes\"])\n    best_val_row = history[stopper.best_epoch - 1]\n\n    torch.save(dict(model_state_dict=stopper.best_model_state, optimizer_state_dict=stopper.best_opt_state,\n                    epoch=stopper.best_epoch, best_val_macro_f1=stopper.best_score, optimizer=opt_name,\n                    learning_rate=lr, seed=seed, class_to_idx=CLASS_TO_IDX, feat_mean=FEAT_MEAN, feat_std=FEAT_STD),\n               rdir / \"best.pt\")\n    pd.DataFrame(history).to_csv(rdir / \"history.csv\", index=False)\n    pd.DataFrame(dict(optimizer=opt_name, learning_rate=lr, seed=seed, **{\"class\": CLASS_NAMES}, support=tm[\"support\"].astype(int),\n                      precision=tm[\"prec\"], recall=tm[\"rec\"], f1=tm[\"f1\"], auc=tm[\"auc_per_class\"])).to_csv(rdir / \"classwise.csv\", index=False)\n    np.save(rdir / \"confusion_matrix.npy\", tm[\"cm\"])\n\n    result = dict(run_id=run_id, optimizer=opt_name, learning_rate=lr, seed=seed,\n                  best_epoch=stopper.best_epoch, epochs_run=len(history), stopped_early=bool(stopper.should_stop),\n                  best_val_macro_f1=float(stopper.best_score), val_accuracy_at_best=float(best_val_row[\"val_acc\"]),\n                  test_accuracy=tm[\"accuracy\"], test_macro_precision=tm[\"macro_precision\"], test_macro_recall=tm[\"macro_recall\"],\n                  test_macro_f1=tm[\"macro_f1\"], test_macro_auc=tm[\"macro_auc\"], test_loss=float(te_loss),\n                  n_test_classes_evaluated=tm[\"n_classes_evaluated\"], n_auc_classes=tm[\"n_auc_classes\"],\n                  training_time_s=float(train_time), n_params=count_params(model))\n    json.dump(result, open(rdir / \"result.json\", \"w\"), indent=1)      # written last = marks the run as complete\n\n    del model, optimizer, tr_loader, va_loader, te_loader, stopper\n    gc.collect()\n    if DEVICE.type == \"cuda\": torch.cuda.empty_cache()\n    return result\n\ndef run_optimizer_block(opt_name: str):\n    \"\"\"Runs (or skips if finished) every learning-rate x seed combination for one optimizer.\"\"\"\n    jobs = [(lr, s) for lr in CFG[\"learning_rates\"] for s in CFG[\"seeds\"]]\n    results = []\n    for lr, s in tqdm(jobs, desc=f\"{opt_name} runs\"):\n        r = run_experiment(opt_name, lr, s)\n        results.append(r)\n        tqdm.write(f\"{r['run_id']:28s} best_ep={r['best_epoch']:3d}/{r['epochs_run']:3d} val_F1={r['best_val_macro_f1']:.4f} \"\n                   f\"| test acc={r['test_accuracy']:.4f} F1={r['test_macro_f1']:.4f} AUC={r['test_macro_auc']:.4f} | {r['training_time_s']:.0f}s\")\n    return pd.DataFrame(results)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-09T12:36:54.554501Z","iopub.execute_input":"2026-11-09T12:36:54.555242Z","iopub.status.idle":"2026-11-09T12:36:54.578344Z","shell.execute_reply.started":"2026-11-09T12:36:54.555197Z","shell.execute_reply":"2026-11-09T12:36:54.5776